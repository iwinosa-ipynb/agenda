# ---------------------------------------------------------------------------
# Agenda — environment variables (placeholders only, never commit real values)
# Copy this file to `.env` and replace the placeholders.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (via the pg driver adapter).
# Replace USER, PASSWORD and HOST with real values — never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/agenda?schema=public"

# Auth.js session encryption secret. Generate with:
#   npx auth secret        (or)   openssl rand -base64 32
AUTH_SECRET=""

# Public base URL of the app. Required in production. Used to derive OAuth
# callback URLs unless explicit per-provider callback URIs are set below.
AUTH_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# Trust the incoming Host header. Required when self-hosting or running
# `npm run start` locally. (Vercel sets this automatically.)
AUTH_TRUST_HOST="true"

# Shared secret for the scheduled verification worker (vercel.json cron →
# /api/cron/verify-posts). Production must set this to a strong random secret
# (e.g. `openssl rand -base64 32`). Every request to the cron endpoint must
# send it as:  Authorization: Bearer <CRON_SECRET>  — requests without it,
# or when this variable is unset on the server, are refused (fail closed).
# Vercel Cron sends this header automatically when CRON_SECRET is set.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Email sending (Stage 10 — email verification)
# ---------------------------------------------------------------------------
# Provider for transactional email. Currently only "brevo" is implemented.
# Leave unset to run without email: signup still works, but verification
# emails fail EXPLICITLY (no fake delivery) and users see a clear error.
EMAIL_PROVIDER=""

# Brevo (Sendinblue) transactional API key. Create an account at brevo.com,
# then SMTP & API → API Keys. Server-side only; never expose to the client.
BREVO_API_KEY=""

# Verified sender address for outgoing email (must be a validated sender or
# domain address in Brevo). Required when EMAIL_PROVIDER=brevo.
EMAIL_FROM_ADDRESS=""

# Display name on outgoing email (defaults to "Agenda").
EMAIL_FROM_NAME="Agenda"

# Future integrations — leave blank until implemented.
# ---------------------------------------------------------------------------
# X (Twitter) verification — official X API v2 post lookup
# (GET https://api.x.com/2/tweets/:id). App-only Bearer Token from the X
# developer portal (Project → App → Keys and tokens). Server-side only;
# never expose this to client code.
X_BEARER_TOKEN=""

# X OAuth 2.0 (Authorization Code + PKCE, confidential client) — REQUIRED
# for the creator "Connect X" flow. Create a Web App type project/app in the
# X developer portal, enable OAuth 2.0 with confidential-client credentials,
# and register the callback URL EXACTLY as configured here.
#
#   Redirect URI (required value in the X developer portal):
#     ${APP_BASE_URL}/api/auth/callback/x      e.g. http://localhost:3000/api/auth/callback/x
#
# X_OAUTH_REDIRECT_URI is optional: when unset, Agenda derives
# ${APP_BASE_URL}/api/auth/callback/x. Set it explicitly in production or
# whenever the registered URI differs from the APP_BASE_URL derivation.
#
# Scopes requested (fixed in code): users.read tweet.read offline.access
# — offline.access enables server-side token refresh; omitting it means
# access tokens expire and creators must reconnect.
X_OAUTH_CLIENT_ID=""
X_OAUTH_CLIENT_SECRET=""
# Optional explicit callback; falls back to APP_BASE_URL-derived URL.
# MUST match the URI registered in the X developer portal character-for-character.
X_OAUTH_REDIRECT_URI=""

# TikTok verification — official TikTok Display API video query
# (POST https://open.tiktokapis.com/v2/video/query/, scope `video.list`).
# This endpoint requires a USER-CONTEXT access token (Bearer act.…)
# obtained through TikTok OAuth authorization by the creator — an app-level
# client_key/client_secret alone cannot call it. The project does not yet
# implement the TikTok OAuth flow, so no token can be provided yet; until
# then TikTok verification fails safely as unconfigured (PROVIDER_AUTH).
#
# When the OAuth flow lands, store the per-creator token (encrypted, in
# SocialAccount) — do NOT use a shared app-wide token for creator data. The
# Stage 8 connection flow does exactly that; this env var remains only as a
# single-tenant local-development fallback and is ignored when a creator's
# connected token exists.
# TIKTOK_USER_ACCESS_TOKEN=""
#
# TikTok Login Kit (OAuth Authorization Code + PKCE) — REQUIRED for the
# creator "Connect TikTok" flow. Register a redirect URL in the TikTok
# developer portal matching the callback below.
#
#   Redirect URI (required value in the TikTok developer portal):
#     ${APP_BASE_URL}/api/auth/callback/tiktok  e.g. http://localhost:3000/api/auth/callback/tiktok
#
# TIKTOK_REDIRECT_URI is optional: when unset, Agenda derives
# ${APP_BASE_URL}/api/auth/callback/tiktok. Set it explicitly in production
# or whenever the registered URI differs from the APP_BASE_URL derivation.
#
# Scopes requested (fixed in code): user.info.basic, video.list
# TikTok access tokens are short-lived (~24h) and refreshed server-side with
# the stored refresh token; refresh token ~365d.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# Optional explicit callback; falls back to APP_BASE_URL-derived URL.
# MUST match the URI registered in the TikTok developer portal character-for-character.
TIKTOK_REDIRECT_URI=""

# Encryption key for OAuth tokens at rest (X + TikTok user access/refresh
# tokens stored in SocialAccount). REQUIRED in production BEFORE any creator
# connects a social account: the connection flow fails closed rather than
# persisting plaintext tokens (AES-256-GCM, random IV per operation).
# Generate with:  openssl rand -base64 32
SOCIAL_TOKEN_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Payments — Paystack (Stage 14B)
# ---------------------------------------------------------------------------
# Secret API key from your Paystack dashboard (Settings → API Keys & Webhooks).
# SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_, never expose to the
# browser, never log it. While this is unset the payment provider is DORMANT:
# the webhook route answers 503, payment initiation is refused explicitly, and
# nothing invents a fake success (fail closed).
PAYSTACK_SECRET_KEY=""

# Public key (pk_…) is NOT required by the implemented flow: charge
# initialization happens server-side and the advertiser is redirected to
# Paystack's hosted payment page. Leave blank unless a client-side popup
# flow is introduced later.
PAYSTACK_PUBLIC_KEY=""

# Optional API base override for tests; production defaults to
# https://api.paystack.co. Leave unset in production.
PAYSTACK_BASE_URL=""

# Webhook URL to register in the Paystack dashboard (HTTPS required):
#   ${APP_BASE_URL}/api/webhooks/payments/paystack
# Paystack signs deliveries with the SECRET KEY (HMAC-SHA512 over the raw
# body in the x-paystack-signature header) — no separate webhook secret.
